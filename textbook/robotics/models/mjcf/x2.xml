      <geom name="rotor3" class="rotor" pos=".14 .18 .08" mass=".25" rgba="0.25 0.25 0.28 1" />
      <geom name="rotor4" class="rotor" pos=".14 -.18 .08" mass=".25" rgba="0.25 0.25 0.28 1" />
