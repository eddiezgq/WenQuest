flowchart TB
  AC["单相交流 110–250 V<br/>保险丝 10 A · 压敏电阻"] --> EMI["电磁兼容滤波<br/>X 电容 · 共模电感 · Y 电容"]
  EMI --> NTC["浪涌限流<br/>热敏电阻 + 继电器旁路"]
  NTC --> BR["整流桥<br/>GBU1006"]
  BR --> PFC["功率因数校正（升压，连续导通）<br/>ICE3PCS01G · IPA60R180P7S · C3D06060A<br/>电感（定制）"]
  PFC --> BUS["母线约 380 V<br/>2 × 330 µF / 450 V"]
  BUS --> IPM["智能功率模块（三相逆变）<br/>STGIPS14K60T · 三只采样电阻"]
  IPM --> MOT(("永磁同步直驱电机<br/>550 W · 峰值 ≥ 3 N·m"))
  BUS --> AUX["反激辅助电源<br/>TOP266KG · 变压器（定制）"]
  AUX --> R24["24 V：电磁铁 · 步进 · 照明"]
  AUX --> R15["15 V：功率模块驱动"]
  R15 --> R33["5 V / 3.3 V 稳压"]
  R33 --> MCU["主控 STM32G431CBT6<br/>磁场定向控制 · 缝纫状态机<br/>片内运放采三相电流 · 比较器过流"]
  MCU -->|PWM| IPM
  MCU --> SOL["电磁铁驱动 × 3<br/>剪线 · 拨线 · 抬压脚<br/>AOD4184A + 钳位"]
  MCU --> STEP["针距步进驱动<br/>TMC2226-SA"]
  ENC["电机编码器 ABZ + UVW<br/>针位传感器"] --> SCH["施密特整形<br/>SN74LVC14A"] --> MCU
  PED["脚踏板（霍尔）"] --> MCU
  MCU <--> ISO["隔离：ADuM1201 + 隔离电源 B0505S<br/>RS-485 MAX3485"] <--> PANEL["操作面板（另一端设备）<br/>联网经面板（MQTT）"]
