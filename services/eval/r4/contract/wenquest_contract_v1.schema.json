{
 "$schema": "https://json-schema.org/draft/2020-12/schema",
 "$id": "wenquest-contract-v1",
 "title": "问渠数据契约 v1（问渠 ⇄ 校情中枢）",
 "type": "object",
 "additionalProperties": false,
 "required": [
  "contract_version",
  "direction",
  "school_id",
  "source",
  "generated_at",
  "batch_id",
  "records"
 ],
 "properties": {
  "contract_version": {
   "const": "1.0"
  },
  "direction": {
   "enum": [
    "问渠→校情中枢",
    "校情中枢→问渠"
   ]
  },
  "school_id": {
   "type": "string"
  },
  "source": {
   "type": "string"
  },
  "generated_at": {
   "type": "string",
   "format": "date-time"
  },
  "batch_id": {
   "type": "string",
   "description": "幂等键：同一批次重复推送只处理一次"
  },
  "records": {
   "type": "array",
   "items": {
    "oneOf": [
     {
      "type": "object",
      "additionalProperties": false,
      "required": [
       "kind",
       "privacy",
       "offering",
       "provenance",
       "n_students",
       "threshold",
       "student_pass_line",
       "objectives"
      ],
      "properties": {
       "kind": {
        "const": "course_objective_attainment"
       },
       "privacy": {
        "const": "汇总"
       },
       "offering": {
        "type": "object",
        "required": [
         "course_code",
         "term",
         "offering_id"
        ],
        "additionalProperties": false,
        "properties": {
         "course_code": {
          "type": "string",
          "description": "教务系统课程代码，用于与培养方案对接"
         },
         "term": {
          "type": "string",
          "pattern": "^[0-9]{4}-[0-9]{4}-[12]$"
         },
         "offering_id": {
          "type": "string"
         },
         "course_name": {
          "type": "string"
         }
        }
       },
       "provenance": {
        "type": "object",
        "required": [
         "method",
         "method_version",
         "snapshot_id"
        ],
        "additionalProperties": false,
        "properties": {
         "method": {
          "type": "string"
         },
         "method_version": {
          "type": "string"
         },
         "snapshot_id": {
          "type": "string"
         }
        }
       },
       "n_students": {
        "type": "integer",
        "minimum": 1
       },
       "threshold": {
        "type": "number",
        "minimum": 0,
        "maximum": 1
       },
       "student_pass_line": {
        "type": "number",
        "minimum": 0,
        "maximum": 1
       },
       "objectives": {
        "type": "array",
        "minItems": 1,
        "items": {
         "type": "object",
         "additionalProperties": false,
         "required": [
          "co_id",
          "name",
          "direct",
          "achieved",
          "student_pass_rate",
          "indirect",
          "components",
          "evidence"
         ],
         "properties": {
          "co_id": {
           "type": "string"
          },
          "name": {
           "type": "string"
          },
          "direct": {
           "type": "number",
           "minimum": 0,
           "maximum": 1
          },
          "achieved": {
           "type": "boolean"
          },
          "student_pass_rate": {
           "type": "number",
           "minimum": 0,
           "maximum": 1
          },
          "indirect": {
           "oneOf": [
            {
             "type": "number",
             "minimum": 0,
             "maximum": 1
            },
            {
             "type": "null"
            }
           ]
          },
          "components": {
           "type": "array",
           "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
             "name",
             "weight",
             "rate"
            ],
            "properties": {
             "name": {
              "type": "string"
             },
             "weight": {
              "type": "number",
              "minimum": 0,
              "maximum": 1
             },
             "rate": {
              "type": "number",
              "minimum": 0,
              "maximum": 1
             }
            }
           }
          },
          "weak_items": {
           "type": "array",
           "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
             "item_id",
             "label",
             "rate"
            ],
            "properties": {
             "item_id": {
              "type": "string"
             },
             "label": {
              "type": "string"
             },
             "rate": {
              "type": "number",
              "minimum": 0,
              "maximum": 1
             }
            }
           }
          },
          "evidence": {
           "type": "object",
           "required": [
            "url",
            "scope"
           ],
           "additionalProperties": false,
           "properties": {
            "url": {
             "type": "string",
             "pattern": "^https://"
            },
            "scope": {
             "enum": [
              "课程负责人",
              "任课教师",
              "评估办",
              "辅导员",
              "教师本人"
             ]
            }
           }
          }
         }
        }
       }
      }
     },
     {
      "type": "object",
      "additionalProperties": false,
      "required": [
       "kind",
       "privacy",
       "offering",
       "provenance",
       "n_students",
       "pre_mean",
       "post_mean",
       "gain"
      ],
      "properties": {
       "kind": {
        "const": "learning_gain"
       },
       "privacy": {
        "const": "汇总"
       },
       "offering": {
        "type": "object",
        "required": [
         "course_code",
         "term",
         "offering_id"
        ],
        "additionalProperties": false,
        "properties": {
         "course_code": {
          "type": "string",
          "description": "教务系统课程代码，用于与培养方案对接"
         },
         "term": {
          "type": "string",
          "pattern": "^[0-9]{4}-[0-9]{4}-[12]$"
         },
         "offering_id": {
          "type": "string"
         },
         "course_name": {
          "type": "string"
         }
        }
       },
       "provenance": {
        "type": "object",
        "required": [
         "method",
         "method_version",
         "snapshot_id"
        ],
        "additionalProperties": false,
        "properties": {
         "method": {
          "type": "string"
         },
         "method_version": {
          "type": "string"
         },
         "snapshot_id": {
          "type": "string"
         }
        }
       },
       "n_students": {
        "type": "integer",
        "minimum": 15,
        "description": "少于 15 人不推送（上篇 3.3）"
       },
       "pre_mean": {
        "type": "number"
       },
       "post_mean": {
        "type": "number"
       },
       "gain": {
        "type": "number"
       },
       "by_kp": {
        "type": "array",
        "items": {
         "type": "object",
         "required": [
          "kp_id",
          "gain"
         ],
         "additionalProperties": false,
         "properties": {
          "kp_id": {
           "type": "string"
          },
          "label": {
           "type": "string"
          },
          "gain": {
           "type": "number"
          }
         }
        }
       }
      }
     },
     {
      "type": "object",
      "additionalProperties": false,
      "required": [
       "kind",
       "privacy",
       "offering",
       "provenance",
       "n_responses",
       "round",
       "themes"
      ],
      "properties": {
       "kind": {
        "const": "feedback_themes"
       },
       "privacy": {
        "const": "汇总"
       },
       "offering": {
        "type": "object",
        "required": [
         "course_code",
         "term",
         "offering_id"
        ],
        "additionalProperties": false,
        "properties": {
         "course_code": {
          "type": "string",
          "description": "教务系统课程代码，用于与培养方案对接"
         },
         "term": {
          "type": "string",
          "pattern": "^[0-9]{4}-[0-9]{4}-[12]$"
         },
         "offering_id": {
          "type": "string"
         },
         "course_name": {
          "type": "string"
         }
        }
       },
       "provenance": {
        "type": "object",
        "required": [
         "method",
         "method_version",
         "snapshot_id"
        ],
        "additionalProperties": false,
        "properties": {
         "method": {
          "type": "string"
         },
         "method_version": {
          "type": "string"
         },
         "snapshot_id": {
          "type": "string"
         }
        }
       },
       "n_responses": {
        "type": "integer",
        "minimum": 5,
        "description": "少于 5 份不推送（上篇 3.4）"
       },
       "round": {
        "enum": [
         "期末"
        ],
        "description": "期中评教只给教师本人，不推送（H3）"
       },
       "themes": {
        "type": "array",
        "items": {
         "type": "object",
         "required": [
          "theme",
          "count",
          "tone"
         ],
         "additionalProperties": false,
         "properties": {
          "theme": {
           "type": "string"
          },
          "count": {
           "type": "integer",
           "minimum": 1
          },
          "tone": {
           "enum": [
            "正面",
            "负面",
            "建议"
           ]
          }
         }
        }
       }
      }
     },
     {
      "type": "object",
      "additionalProperties": false,
      "required": [
       "kind",
       "privacy",
       "offering",
       "provenance",
       "student_ref",
       "purpose",
       "visible_to",
       "signals",
       "expires"
      ],
      "properties": {
       "kind": {
        "const": "student_risk"
       },
       "privacy": {
        "const": "个人"
       },
       "offering": {
        "type": "object",
        "required": [
         "course_code",
         "term",
         "offering_id"
        ],
        "additionalProperties": false,
        "properties": {
         "course_code": {
          "type": "string",
          "description": "教务系统课程代码，用于与培养方案对接"
         },
         "term": {
          "type": "string",
          "pattern": "^[0-9]{4}-[0-9]{4}-[12]$"
         },
         "offering_id": {
          "type": "string"
         },
         "course_name": {
          "type": "string"
         }
        }
       },
       "provenance": {
        "type": "object",
        "required": [
         "method",
         "method_version",
         "snapshot_id"
        ],
        "additionalProperties": false,
        "properties": {
         "method": {
          "type": "string"
         },
         "method_version": {
          "type": "string"
         },
         "snapshot_id": {
          "type": "string"
         }
        }
       },
       "student_ref": {
        "type": "string",
        "description": "学号，仅在有权限的预警视图中解析"
       },
       "purpose": {
        "const": "学业预警与辅导"
       },
       "visible_to": {
        "type": "array",
        "items": {
         "enum": [
          "任课教师",
          "辅导员"
         ]
        },
        "minItems": 1
       },
       "signals": {
        "type": "array",
        "minItems": 1,
        "items": {
         "type": "object",
         "required": [
          "type",
          "detail"
         ],
         "additionalProperties": false,
         "properties": {
          "type": {
           "enum": [
            "知识点未掌握",
            "作业缺交",
            "实验未完成",
            "答辩未通过",
            "长期未登录"
           ]
          },
          "detail": {
           "type": "string"
          }
         }
        }
       },
       "expires": {
        "type": "string",
        "format": "date"
       }
      }
     },
     {
      "type": "object",
      "additionalProperties": false,
      "required": [
       "kind",
       "privacy",
       "offering",
       "provenance",
       "task_id",
       "status"
      ],
      "properties": {
       "kind": {
        "const": "task_receipt"
       },
       "privacy": {
        "const": "汇总"
       },
       "offering": {
        "type": "object",
        "required": [
         "course_code",
         "term",
         "offering_id"
        ],
        "additionalProperties": false,
        "properties": {
         "course_code": {
          "type": "string",
          "description": "教务系统课程代码，用于与培养方案对接"
         },
         "term": {
          "type": "string",
          "pattern": "^[0-9]{4}-[0-9]{4}-[12]$"
         },
         "offering_id": {
          "type": "string"
         },
         "course_name": {
          "type": "string"
         }
        }
       },
       "provenance": {
        "type": "object",
        "required": [
         "method",
         "method_version",
         "snapshot_id"
        ],
        "additionalProperties": false,
        "properties": {
         "method": {
          "type": "string"
         },
         "method_version": {
          "type": "string"
         },
         "snapshot_id": {
          "type": "string"
         }
        }
       },
       "task_id": {
        "type": "string"
       },
       "status": {
        "enum": [
         "已接收",
         "进行中",
         "已完成",
         "退回说明"
        ]
       },
       "note": {
        "type": "string"
       },
       "evidence": {
        "type": "object",
        "required": [
         "url",
         "scope"
        ],
        "additionalProperties": false,
        "properties": {
         "url": {
          "type": "string",
          "pattern": "^https://"
         },
         "scope": {
          "enum": [
           "课程负责人",
           "任课教师",
           "评估办",
           "辅导员",
           "教师本人"
          ]
         }
        }
       }
      }
     },
     {
      "type": "object",
      "additionalProperties": false,
      "required": [
       "kind",
       "task_id",
       "offering",
       "target",
       "reason",
       "due"
      ],
      "properties": {
       "kind": {
        "const": "improvement_task"
       },
       "task_id": {
        "type": "string"
       },
       "offering": {
        "type": "object",
        "required": [
         "course_code",
         "term",
         "offering_id"
        ],
        "additionalProperties": false,
        "properties": {
         "course_code": {
          "type": "string",
          "description": "教务系统课程代码，用于与培养方案对接"
         },
         "term": {
          "type": "string",
          "pattern": "^[0-9]{4}-[0-9]{4}-[12]$"
         },
         "offering_id": {
          "type": "string"
         },
         "course_name": {
          "type": "string"
         }
        }
       },
       "target": {
        "type": "string",
        "description": "课程目标或指标点"
       },
       "reason": {
        "type": "string"
       },
       "suggested_actions": {
        "type": "array",
        "items": {
         "type": "string"
        }
       },
       "due": {
        "type": "string",
        "format": "date"
       }
      }
     }
    ]
   }
  }
 }
}