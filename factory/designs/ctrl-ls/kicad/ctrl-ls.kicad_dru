(version 1)
(rule "AC_L-AC_N"
  (condition "(A.NetClass == 'AC_L' && B.NetClass == 'AC_N') || (A.NetClass == 'AC_N' && B.NetClass == 'AC_L')")
  (constraint clearance (min 2.6mm)))
(rule "AC_L-HV"
  (condition "(A.NetClass == 'AC_L' && B.NetClass == 'HV') || (A.NetClass == 'HV' && B.NetClass == 'AC_L')")
  (constraint clearance (min 1.5mm)))
(rule "AC_L-HVSig"
  (condition "(A.NetClass == 'AC_L' && B.NetClass == 'HVSig') || (A.NetClass == 'HVSig' && B.NetClass == 'AC_L')")
  (constraint clearance (min 1.5mm)))
(rule "AC_L-Boot"
  (condition "(A.NetClass == 'AC_L' && B.NetClass == 'Boot') || (A.NetClass == 'Boot' && B.NetClass == 'AC_L')")
  (constraint clearance (min 1.5mm)))
(rule "AC_N-HV"
  (condition "(A.NetClass == 'AC_N' && B.NetClass == 'HV') || (A.NetClass == 'HV' && B.NetClass == 'AC_N')")
  (constraint clearance (min 1.5mm)))
(rule "AC_N-HVSig"
  (condition "(A.NetClass == 'AC_N' && B.NetClass == 'HVSig') || (A.NetClass == 'HVSig' && B.NetClass == 'AC_N')")
  (constraint clearance (min 1.5mm)))
(rule "AC_N-Boot"
  (condition "(A.NetClass == 'AC_N' && B.NetClass == 'Boot') || (A.NetClass == 'Boot' && B.NetClass == 'AC_N')")
  (constraint clearance (min 1.5mm)))
(rule "AC_L-Return"
  (condition "(A.NetClass == 'AC_L' && B.NetClass == 'Return') || (A.NetClass == 'Return' && B.NetClass == 'AC_L')")
  (constraint clearance (min 2.2mm)))
(rule "AC_L-Power"
  (condition "(A.NetClass == 'AC_L' && B.NetClass == 'Power') || (A.NetClass == 'Power' && B.NetClass == 'AC_L')")
  (constraint clearance (min 2.2mm)))
(rule "AC_L-Ground"
  (condition "(A.NetClass == 'AC_L' && B.NetClass == 'Ground') || (A.NetClass == 'Ground' && B.NetClass == 'AC_L')")
  (constraint clearance (min 2.2mm)))
(rule "AC_L-Default"
  (condition "(A.NetClass == 'AC_L' && B.NetClass == 'Default') || (A.NetClass == 'Default' && B.NetClass == 'AC_L')")
  (constraint clearance (min 2.2mm)))
(rule "AC_N-Return"
  (condition "(A.NetClass == 'AC_N' && B.NetClass == 'Return') || (A.NetClass == 'Return' && B.NetClass == 'AC_N')")
  (constraint clearance (min 2.2mm)))
(rule "AC_N-Power"
  (condition "(A.NetClass == 'AC_N' && B.NetClass == 'Power') || (A.NetClass == 'Power' && B.NetClass == 'AC_N')")
  (constraint clearance (min 2.2mm)))
(rule "AC_N-Ground"
  (condition "(A.NetClass == 'AC_N' && B.NetClass == 'Ground') || (A.NetClass == 'Ground' && B.NetClass == 'AC_N')")
  (constraint clearance (min 2.2mm)))
(rule "AC_N-Default"
  (condition "(A.NetClass == 'AC_N' && B.NetClass == 'Default') || (A.NetClass == 'Default' && B.NetClass == 'AC_N')")
  (constraint clearance (min 2.2mm)))
(rule "HV-Return"
  (condition "(A.NetClass == 'HV' && B.NetClass == 'Return') || (A.NetClass == 'Return' && B.NetClass == 'HV')")
  (constraint clearance (min 2.2mm)))
(rule "HV-Power"
  (condition "(A.NetClass == 'HV' && B.NetClass == 'Power') || (A.NetClass == 'Power' && B.NetClass == 'HV')")
  (constraint clearance (min 2.2mm)))
(rule "HV-Ground"
  (condition "(A.NetClass == 'HV' && B.NetClass == 'Ground') || (A.NetClass == 'Ground' && B.NetClass == 'HV')")
  (constraint clearance (min 2.2mm)))
(rule "HV-Default"
  (condition "(A.NetClass == 'HV' && B.NetClass == 'Default') || (A.NetClass == 'Default' && B.NetClass == 'HV')")
  (constraint clearance (min 2.2mm)))
(rule "HVSig-Return"
  (condition "(A.NetClass == 'HVSig' && B.NetClass == 'Return') || (A.NetClass == 'Return' && B.NetClass == 'HVSig')")
  (constraint clearance (min 2.2mm)))
(rule "HVSig-Power"
  (condition "(A.NetClass == 'HVSig' && B.NetClass == 'Power') || (A.NetClass == 'Power' && B.NetClass == 'HVSig')")
  (constraint clearance (min 2.2mm)))
(rule "HVSig-Ground"
  (condition "(A.NetClass == 'HVSig' && B.NetClass == 'Ground') || (A.NetClass == 'Ground' && B.NetClass == 'HVSig')")
  (constraint clearance (min 2.2mm)))
(rule "HVSig-Default"
  (condition "(A.NetClass == 'HVSig' && B.NetClass == 'Default') || (A.NetClass == 'Default' && B.NetClass == 'HVSig')")
  (constraint clearance (min 2.2mm)))
(rule "Boot-Return"
  (condition "(A.NetClass == 'Boot' && B.NetClass == 'Return') || (A.NetClass == 'Return' && B.NetClass == 'Boot')")
  (constraint clearance (min 2.2mm)))
(rule "Boot-Power"
  (condition "(A.NetClass == 'Boot' && B.NetClass == 'Power') || (A.NetClass == 'Power' && B.NetClass == 'Boot')")
  (constraint clearance (min 2.2mm)))
(rule "Boot-Ground"
  (condition "(A.NetClass == 'Boot' && B.NetClass == 'Ground') || (A.NetClass == 'Ground' && B.NetClass == 'Boot')")
  (constraint clearance (min 2.2mm)))
(rule "Boot-Default"
  (condition "(A.NetClass == 'Boot' && B.NetClass == 'Default') || (A.NetClass == 'Default' && B.NetClass == 'Boot')")
  (constraint clearance (min 2.2mm)))
(rule "PE-AC_L"
  (condition "(A.NetClass == 'PE' && B.NetClass == 'AC_L') || (A.NetClass == 'AC_L' && B.NetClass == 'PE')")
  (constraint clearance (min 4.2mm)))
(rule "PE-AC_N"
  (condition "(A.NetClass == 'PE' && B.NetClass == 'AC_N') || (A.NetClass == 'AC_N' && B.NetClass == 'PE')")
  (constraint clearance (min 4.2mm)))
(rule "PE-HV"
  (condition "(A.NetClass == 'PE' && B.NetClass == 'HV') || (A.NetClass == 'HV' && B.NetClass == 'PE')")
  (constraint clearance (min 4.2mm)))
(rule "PE-HVSig"
  (condition "(A.NetClass == 'PE' && B.NetClass == 'HVSig') || (A.NetClass == 'HVSig' && B.NetClass == 'PE')")
  (constraint clearance (min 4.2mm)))
(rule "PE-Boot"
  (condition "(A.NetClass == 'PE' && B.NetClass == 'Boot') || (A.NetClass == 'Boot' && B.NetClass == 'PE')")
  (constraint clearance (min 4.2mm)))
(rule "PE-Return"
  (condition "(A.NetClass == 'PE' && B.NetClass == 'Return') || (A.NetClass == 'Return' && B.NetClass == 'PE')")
  (constraint clearance (min 4.2mm)))
(rule "PE-Power"
  (condition "(A.NetClass == 'PE' && B.NetClass == 'Power') || (A.NetClass == 'Power' && B.NetClass == 'PE')")
  (constraint clearance (min 4.2mm)))
(rule "PE-Ground"
  (condition "(A.NetClass == 'PE' && B.NetClass == 'Ground') || (A.NetClass == 'Ground' && B.NetClass == 'PE')")
  (constraint clearance (min 4.2mm)))
(rule "PE-Default"
  (condition "(A.NetClass == 'PE' && B.NetClass == 'Default') || (A.NetClass == 'Default' && B.NetClass == 'PE')")
  (constraint clearance (min 4.2mm)))
(rule "same_footprint_pads"
  (condition "A.Type == 'Pad' && B.Type == 'Pad' && A.Parent.Reference == B.Parent.Reference")
  (constraint clearance (min 0.15mm)))
