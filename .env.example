# 复制为 .env 后填写。.env 含密码和密钥，只放在服务器上，不要提交到 Git。
# 本地试用用默认值即可；上线到云服务器时，按“生产”注释修改。

# ===== 部署地区（第 34 轮）=====
# 不填或 us = 美国（现有行为）；cn = 中国大陆：只用已备案模型（DeepSeek，Claude 钥匙即使填了也不用），
# 不加载美国服务器专用的站点（deploy/caddy-extra/us/）。国内部署见 docs/帮助/国内部署指南.html
WQ_REGION=

# ===== 站点 =====
# 教学引擎（Moodle 经典界面）的完整地址。生产：https://classic.<你的域名>
MOODLE_WWWROOT=http://localhost:8080
# 仅本地试用时使用的端口；生产由 Caddy 统一走 80/443，此项不起作用
HTTP_PORT=8080
# 生产设为 true（HTTPS 由 Caddy 提供）
MOODLE_SSLPROXY=false
MOODLE_SITE_NAME=问渠 WenQuest
MOODLE_SITE_SHORTNAME=wenquest
# 站点默认语言：en 或 zh_cn。两种语言包都已安装，用户可在页面右上角切换
MOODLE_LANG=zh_cn
# 美国东部：America/New_York；中国：Asia/Shanghai
MOODLE_TIMEZONE=Asia/Shanghai

# ===== 生产：域名与 HTTPS =====
# 主域名（不带 www、不带 https://）。官网在该域名，问渠学习平台在 learn. 子域名，经典界面在 classic. 子域名
SITE_DOMAIN=example.com
# 申请 HTTPS 证书时登记的邮箱，证书异常时 Let's Encrypt 会发邮件提醒
ACME_EMAIL=admin@example.com
# 学习平台镜像。本地构建时留默认；生产由自动部署流程写入 ghcr.io/<GitHub 用户名>/<仓库名>/engine:<版本>
ENGINE_IMAGE=wenquest/engine:0.1

# 网关、网页镜像。本地构建时留默认；生产由自动部署流程写入
GATEWAY_IMAGE=wenquest/gateway:0.2
WEB_IMAGE=wenquest/web:0.2
ANIMATOR_IMAGE=wenquest/animator:0.1
LABCHECK_IMAGE=wenquest/labcheck:0.1
MICROSYNTH_IMAGE=wenquest/micro-synth:0.1
# 基础镜像（数据库、缓存、网页服务器、异地备份工具）。不填 = Docker Hub 官方镜像；
# 国内 Docker Hub 拉不动时，填同步到国内仓库的同一版本，如 registry.cn-hangzhou.aliyuncs.com/<命名空间>/postgres:16-alpine
DB_IMAGE=
REDIS_IMAGE=
CADDY_IMAGE=
RCLONE_IMAGE=

# ===== 问渠学习平台（新界面）=====
# 问渠网页端地址。生产：https://learn.<你的域名>
APP_URL=http://localhost:8088
# 仅本地试用时使用的端口
APP_PORT=8088
# 加密登录会话用的密钥，填一串足够长的随机字符（生产由 deploy/init-env.sh 自动生成）
WQ_SECRET_KEY=请改成一串随机字符
# 用户未选择语言时的默认界面语言：zh 或 en
WQ_DEFAULT_LANG=zh
# 网关对外地址。网页端留空即可；微信小程序上线时填 https://learn.<你的域名>
WQ_PUBLIC_URL=

# ===== 管理员（仅首次安装时使用）=====
MOODLE_ADMIN_USER=admin
MOODLE_ADMIN_PASSWORD=请改成强密码
MOODLE_ADMIN_EMAIL=admin@example.com

# ===== 数据库 =====
DB_NAME=moodle
DB_USER=moodle
DB_PASSWORD=请改成强密码

# ===== AI 模型（至少填一个）=====
# Claude：在 https://console.anthropic.com 申请。Anthropic 不对中国大陆提供服务。
ANTHROPIC_API_KEY=
CLAUDE_MODEL=claude-sonnet-5
# DeepSeek：在 https://platform.deepseek.com 申请，已完成国内备案，国内部署用它。
DEEPSEEK_API_KEY=

# ===== 发信（找回密码、课程通知）=====
# DigitalOcean 等云主机封锁 25/465/587 端口，请用邮件服务商（Postmark、Mailgun、SendGrid、Brevo 等）的 2525 端口
SMTP_HOST=
SMTP_PORT=2525
SMTP_SECURE=tls
SMTP_USER=
SMTP_PASSWORD=
# 发件地址，须是邮件服务商验证过的域名，如 noreply@<你的域名>
MOODLE_NOREPLY_EMAIL=
# 新的教师申请、课程报名汇总邮件发到这里（留空则发到 MOODLE_ADMIN_EMAIL）
WQ_ADMIN_EMAIL=

# ===== 备份（deploy/backup.sh）=====
# 本机按份数保留（第 19 轮）：部署前备份留最近几份、每天 03:30 的日备份留最近几份
BACKUP_KEEP_COUNT=10
BACKUP_KEEP_DAILY=7
# 剩余空间低于这个百分比时先删旧备份；删完仍不够就跳过本次备份并报警，不把磁盘写满
BACKUP_MIN_FREE_PCT=15
# 异地备份到 S3 兼容存储（DigitalOcean Spaces、AWS S3、阿里云 OSS、腾讯云 COS 等），只传日备份。留空则只在本机保留
# 存储服务商（rclone 的名称）：不填 = DigitalOcean；阿里云 OSS 填 Alibaba，腾讯云 COS 填 TencentCOS，AWS 填 AWS
BACKUP_S3_PROVIDER=
BACKUP_S3_ENDPOINT=
BACKUP_S3_BUCKET=
BACKUP_S3_ACCESS_KEY=
BACKUP_S3_SECRET_KEY=
# 异地备份保留天数，更早的由 backup.sh 自动删除
BACKUP_S3_KEEP_DAYS=30

# 云端 GPU 实验（《人工智能》第 14 轮附，docs/帮助/GPU平台接入说明.md）。留空 = 不开 GPU 实验。
# WQ_GPU_PROVIDER: autodl（国内）或 lambda（美国）
WQ_GPU_PROVIDER=
# AutoDL：控制台 → 设置 → 开发者 Token；机器规格“档次=GPU规格:镜像”，如 basic=v-48g:base-image-mbr2n4urrc
WQ_GPU_AUTODL_TOKEN=
WQ_GPU_AUTODL_SPECS=
# Lambda：Cloud API key；SSH 公钥在 Lambda 控制台登记的名字
WQ_GPU_LAMBDA_KEY=
WQ_GPU_LAMBDA_SSH_KEY=

