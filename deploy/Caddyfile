# Caddy obtains and renews HTTPS certificates automatically once DNS points at this server.
{
	email {$ACME_EMAIL}
}

(security_headers) {
	header {
		Strict-Transport-Security "max-age=31536000; includeSubDomains"
		X-Content-Type-Options "nosniff"
		Referrer-Policy "strict-origin-when-cross-origin"
		-Server
	}
}

# Academy website (static files in site/).
{$SITE_DOMAIN} {
	import security_headers
	encode zstd gzip
	# Sign-in state for the website header (who is signed in, sign out): same gateway as the platform.
	handle /api/v1/auth/* {
		reverse_proxy web:80
	}
	handle {
		root * /srv/site
		try_files {path} {path}/ {path}.html
		file_server
	}
}

www.{$SITE_DOMAIN} {
	redir https://{$SITE_DOMAIN}{uri} permanent
}

# WenQuest learning platform: the web app, with /api handled by the gateway.
learn.{$SITE_DOMAIN} {
	import security_headers
	encode zstd gzip
	request_body {
		max_size 200MB
	}
	reverse_proxy web:80
}

# Classic view (Moodle): course authoring for teachers and activities the new app does not cover yet.
classic.{$SITE_DOMAIN} {
	import security_headers
	encode zstd gzip
	request_body {
		max_size 200MB
	}
	reverse_proxy moodle:80 {
		transport http {
			read_timeout 300s
			write_timeout 300s
		}
	}
}

# 问渠数字工厂（第 3 轮）：独立的一组容器，在 /opt/wenquest/factory，经 factory-edge 网络接过来。
# 工作台与接口 → 枢纽 hub；/mqtt → 统一数据总线的 WebSocket（浏览器只读）。
factory.{$SITE_DOMAIN} {
	import security_headers
	encode zstd gzip
	request_body {
		max_size 60MB
	}
	handle /mqtt* {
		reverse_proxy wqf-bus:9001
	}
	handle {
		reverse_proxy wqf-hub:8100
	}
}

# 数字工厂的 ERPNext（减速器厂）。
erp.{$SITE_DOMAIN} {
	import security_headers
	encode zstd gzip
	request_body {
		max_size 60MB
	}
	reverse_proxy wqf-erp:8080 {
		transport http {
			read_timeout 300s
		}
	}
}

# 数字工厂企业版演示工厂（第 9 轮）：生产模式，与教学工厂隔离；ERPNext 用 demo 站点
demo.{$SITE_DOMAIN} {
	import security_headers
	encode zstd gzip
	request_body {
		max_size 60MB
	}
	handle /mqtt* {
		reverse_proxy wqf-bus-demo:9001
	}
	handle {
		reverse_proxy wqf-hub-demo:8100
	}
}

demo-erp.{$SITE_DOMAIN} {
	import security_headers
	encode zstd gzip
	request_body {
		max_size 60MB
	}
	reverse_proxy wqf-erp-demo:8080 {
		transport http {
			read_timeout 300s
		}
	}
}

# QMS demo (a separate project on the same server, reached over the external qms-edge network).
qms.wenquestrobotics.com {
	encode gzip
	request_body {
		max_size 100MB
	}
	reverse_proxy qms-demo-edge:80
}
