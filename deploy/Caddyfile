# Caddy obtains and renews HTTPS certificates automatically once DNS points at this server.
{
	email {$ACME_EMAIL}
}

(security_headers) {
	header {
		Strict-Transport-Security "max-age=31536000; includeSubDomains"
		X-Content-Type-Options "nosniff"
		Referrer-Policy "strict-origin-when-cross-origin"
		-Server
	}
}

# Academy website (static files in site/).
{$SITE_DOMAIN} {
	import security_headers
	encode zstd gzip
	root * /srv/site
	try_files {path} {path}/ {path}.html
	file_server
}

www.{$SITE_DOMAIN} {
	redir https://{$SITE_DOMAIN}{uri} permanent
}

# Learning platform (Moodle).
learn.{$SITE_DOMAIN} {
	import security_headers
	encode zstd gzip
	request_body {
		max_size 200MB
	}
	reverse_proxy moodle:80 {
		transport http {
			read_timeout 300s
			write_timeout 300s
		}
	}
}
