#!/usr/bin/env python3
"""wqlab — 问渠微电子实验镜像里的小工具。

  wqlab tools                         列出各工具版本（JSON）
  wqlab netlist <x.sch> [-o 目录]     用 Xschem 导出 LVS 网表
  wqlab inv [--wn 0.42] [--wp 0.97] [--schematic 网表] [--out 目录]
                                      第 1 章反相器：版图、DRC、提取、LVS（见 ch1/build_inv.py）
  wqlab flow <config.json> [--out 目录]
                                      LibreLane RTL→GDS，汇总时序、DRC、LVS、面积、用时、内存峰值
  wqlab results <目录>...             把各步的 result.json 合成“结果名 → 数值”，供问渠实验报告回填

贯通项目：
  wqlab start <目录>                  把四步的起始文件复制到自己的目录（含步骤二的起始版图）
  wqlab device --script device_curves.py [--out 目录]
                                      步骤一：SKY130 MOSFET 曲线与参数提取
  wqlab nand2 --start 目录            步骤二：生成起始版图（四个管子已放好，没有连线）
  wqlab nand2 --check 目录 --schematic 网表
                                      步骤二：检查自己画的 目录/nand2.mag（DRC、LVS），并与标准单元 nand2_1 比较
  wqlab test <rtl 目录> [--ref]       步骤三：运行 cocotb 测试（目录里有 src/ 和 test/）；--ref 用参考测试（教师评分）
  wqlab tt <rtl 目录> --config config.json [--out 目录]
                                      步骤四：按 Tiny Tapeout 格式跑 RTL→GDS 并检查流片就绪度

结果格式与 GPU 实验的 wqgpu 一致：{"results": {名: 值}, "env": {工具版本与 PDK}}；回传问渠由以后的调度服务完成。
"""
import argparse
import glob
import importlib.util
import json
import os
import re
import resource
import shutil
import subprocess
import sys
import time
from pathlib import Path

HOME = Path(os.environ.get("WQ_HOME", Path(__file__).resolve().parents[1]))
PDK_ROOT = os.environ.get("PDK_ROOT", "/foss/pdks")
PDK = os.environ.get("PDK", "sky130A")
PDKPATH = Path(os.environ.get("PDKPATH", f"{PDK_ROOT}/{PDK}"))


def sh(cmd, **kw):
    return subprocess.run(cmd, capture_output=True, text=True, **kw)


def first_line(cmd):
    try:
        p = sh(cmd, timeout=60)
        txt = (p.stdout + p.stderr).strip()
        for ln in txt.splitlines():
            if re.search(r"\d+\.\d+", ln):
                return ln.strip()[:120]
        return txt.splitlines()[0][:120] if txt else ""
    except Exception as e:  # noqa: BLE001
        return f"unavailable ({type(e).__name__})"


def tools(_a=None):
    v = {
        "magic": first_line(["magic", "--version"]),
        "netgen": first_line(["sh", "-c", "echo quit | netgen -batch 2>&1 | head -3"]),
        "ngspice": first_line(["ngspice", "-v"]),
        "xschem": first_line(["xschem", "-v"]),
        "klayout": first_line(["klayout", "-v"]),
        "yosys": first_line(["yosys", "-V"]),
        "openroad": first_line(["openroad", "-version"]),
        "librelane": first_line(["librelane", "--version"]),
        "iverilog": first_line(["sh", "-c", "iverilog -V 2>&1 | head -1"]),
        "cocotb": first_line(["sh", "-c", "cocotb-config --version"]),
        "pdk": f"{PDK} @ {PDKPATH}",
    }
    print(json.dumps(v, indent=1, ensure_ascii=False))
    return v


def env():
    return {"PDK": PDK, "PDK_ROOT": PDK_ROOT}


def netlist(a):
    out = Path(a.out or ".").resolve()
    out.mkdir(parents=True, exist_ok=True)
    rc = PDKPATH / "libs.tech" / "xschem" / "xschemrc"
    p = sh(["xschem", "--rcfile", str(rc), "-n", "-s", "-q", "-x", "--tcl", "set lvs_netlist 1", "-o", str(out), str(Path(a.sch).resolve())],
           cwd=out, timeout=300)
    net = out / (Path(a.sch).stem + ".spice")
    if not net.exists():
        sys.exit(f"xschem produced no netlist:\n{p.stdout}{p.stderr}")
    print(net)
    return net


def inv(a):
    os.environ.setdefault("MAGICRC", str(PDKPATH / "libs.tech" / "magic" / f"{PDK}.magicrc"))
    os.environ.setdefault("NETGEN_SETUP", str(PDKPATH / "libs.tech" / "netgen" / f"{PDK}_setup.tcl"))
    sys.path.insert(0, str(HOME / "ch1"))
    import build_inv  # noqa: E402
    r = build_inv.build(a.wn, a.wp, Path(a.out).resolve(), Path(a.schematic).resolve() if a.schematic else None)
    print(json.dumps(r, ensure_ascii=False))
    return r


def _metric(m: dict, *names, default=None):
    for n in names:
        if n in m:
            return m[n]
    return default


def flow(a):
    cfg = Path(a.config).resolve()
    out = Path(a.out or cfg.parent / "runs").resolve()
    work = out / "design"
    if work.exists():
        shutil.rmtree(work)
    shutil.copytree(cfg.parent, work, ignore=shutil.ignore_patterns("runs"))
    cmd = ["librelane", "--manual-pdk", "--pdk-root", PDK_ROOT, "--pdk", PDK, "--run-tag", "wq", "--overwrite", str(work / cfg.name)]
    if not shutil.which("librelane"):
        sys.exit("LibreLane is not installed here: run this step in the WenQuest lab image (wenquest/micro-lab).")
    t0 = time.time()
    with open(out / "librelane.log", "w") as log:
        p = subprocess.run(cmd, cwd=work, stdout=log, stderr=subprocess.STDOUT, timeout=4 * 3600)
    secs = time.time() - t0
    peak_mb = resource.getrusage(resource.RUSAGE_CHILDREN).ru_maxrss / 1024
    mfile = next(iter(glob.glob(str(work / "runs" / "wq" / "final" / "metrics.json"))), None)
    m = json.loads(Path(mfile).read_text()) if mfile else {}
    gds = next(iter(glob.glob(str(work / "runs" / "wq" / "final" / "gds" / "*.gds"))), "")
    res = {
        "exit_code": p.returncode, "seconds": round(secs), "peak_mem_mb": round(peak_mb),
        "gds": gds,
        "setup_ws_ns": _metric(m, "timing__setup__ws", "timing__setup__ws__corner:nom_tt_025C_1v80"),
        "hold_ws_ns": _metric(m, "timing__hold__ws", "timing__hold__ws__corner:nom_tt_025C_1v80"),
        "route_drc_errors": _metric(m, "route__drc_errors"),
        "magic_drc_errors": _metric(m, "magic__drc_error__count"),
        "klayout_drc_errors": _metric(m, "klayout__drc_error__count"),
        "lvs_errors": _metric(m, "design__lvs_error__count"),
        "antenna_violations": _metric(m, "antenna__violating__nets", "route__antenna_violation__count"),
        "cells": _metric(m, "design__instance__count"),
        "core_area_um2": _metric(m, "design__core__area"),
    }
    def zero(x):
        return x is not None and float(x) == 0
    res["tapeout_ready"] = bool(p.returncode == 0 and gds and zero(res["magic_drc_errors"]) and zero(res["lvs_errors"])
                                and res["setup_ws_ns"] is not None and float(res["setup_ws_ns"]) >= 0
                                and res["hold_ws_ns"] is not None and float(res["hold_ws_ns"]) >= 0)
    (out / "result.json").write_text(json.dumps(res, indent=1, ensure_ascii=False))
    print(json.dumps(res, ensure_ascii=False))
    return res


CAP = HOME / "capstone"
# Reference solutions are not in the students' image: teachers (and the acceptance tests) point WQ_CAP_REF at them.
REF = Path(os.environ.get("WQ_CAP_REF", CAP / "ref"))


def need_ref(what: str) -> Path:
    if not REF.exists():
        sys.exit(f"{what}: the reference solution is only available to teachers (set WQ_CAP_REF).")
    return REF


def start(a):
    """Copy the capstone starting files into the student's folder; make the step-two starting layout there."""
    d = Path(a.dir).resolve()
    if d.exists() and any(d.iterdir()):
        sys.exit(f"{d} is not empty; choose a new folder")
    shutil.copytree(CAP / "start", d, ignore=shutil.ignore_patterns("nand2_schematic_start.spice"))
    nand2(argparse.Namespace(start=str(d / "step2_nand2"), check=None, wn=0.42, wp=0.97, schematic=None, out=None))
    print(f"capstone files in {d}: step1_device, step2_nand2, step3_rtl, step4_chip (see README.md)")
    return {"started": str(d)}


def device(a):
    out = Path(a.out).resolve()
    os.environ.setdefault("WQ_PARAMS", str(CAP / "ch1_params.json"))
    script = Path(a.script).resolve() if a.script else need_ref("wqlab device without --script") / "step1_device" / "device_curves.py"
    p = sh([sys.executable, str(script), "--out", str(out)], timeout=1800)
    sys.stdout.write(p.stdout[-2000:]); sys.stderr.write(p.stderr[-2000:])
    prm = json.loads((out / "params.json").read_text()) if (out / "params.json").exists() else {}
    res = {"vtn_v": prm.get("n", {}).get("vt"), "vtp_v": prm.get("p", {}).get("vt"),
           "idsat_n_ua_um": prm.get("n", {}).get("idsat_ua_per_um"), "idsat_p_ua_um": prm.get("p", {}).get("idsat_ua_per_um"),
           "swing_n_mv_dec": prm.get("n", {}).get("swing_mv_dec"), "mobility_ratio": prm.get("mobility_ratio")}
    (out / "result.json").write_text(json.dumps(res, indent=1))
    return res


def stdcell(name="sky130_fd_sc_hd__nand2_1") -> dict:
    """Size (LEF) and transistor widths (SPICE) of a SKY130 standard cell, for the comparison in step two."""
    lib = PDKPATH / "libs.ref" / "sky130_fd_sc_hd"
    out = {"cell": name}
    lef = sorted(glob.glob(str(lib / "lef" / "*.lef")))
    for f in lef:
        m = re.search(rf"MACRO {name}\b.*?SIZE\s+([\d.]+)\s+BY\s+([\d.]+)", Path(f).read_text(errors="replace"), re.S)
        if m:
            out.update(width_um=float(m.group(1)), height_um=float(m.group(2)), area_um2=round(float(m.group(1)) * float(m.group(2)), 3))
            break
    for f in sorted(glob.glob(str(lib / "spice" / "*.spice"))):
        m = re.search(rf"\.subckt {name}\b(.*?)\.ends", Path(f).read_text(errors="replace"), re.S | re.I)
        if m:
            ws = re.findall(r"(nfet|pfet)\S*\s.*?\bw=([\d.]+)", m.group(1), re.I)
            um_ = lambda w: float(w) / 1e6 if float(w) > 100 else float(w)     # the library writes 0.65 μm as 650000 (×1e-6 scale)
            out["nmos_w_um"] = sorted({um_(w) for t, w in ws if t.lower() == "nfet"})
            out["pmos_w_um"] = sorted({um_(w) for t, w in ws if t.lower() == "pfet"})
            break
    return out


def nand2(a):
    """Step two. --start DIR: the four transistors placed, no wiring (open DIR/nand2.mag in Magic and draw the wires);
    --check DIR: DRC, extraction and LVS of the layout DIR/nand2.mag against --schematic (your netlist);
    neither: the reference layout (teachers, acceptance tests)."""
    os.environ.setdefault("MAGICRC", str(PDKPATH / "libs.tech" / "magic" / f"{PDK}.magicrc"))
    os.environ.setdefault("NETGEN_SETUP", str(PDKPATH / "libs.tech" / "netgen" / f"{PDK}_setup.tcl"))
    sys.path.insert(0, str(CAP / "tools"))
    import layout
    if a.start:
        d = Path(a.start).resolve()
        layout.place_nand2(d, a.wn, a.wp)
        shutil.copy(CAP / "start" / "step2_nand2" / "nand2_schematic_start.spice", d / "nand2_schematic.spice")
        print(f"{d}/nand2.mag: four transistors placed (W n {a.wn} μm, p {a.wp} μm). Open it with: magic -rcfile $MAGICRC {d}/nand2.mag")
        print("Save with File → Save (the top cell only). Then: wqlab nand2 --check", d, "--schematic", d / "nand2_schematic.spice")
        return {"started": str(d)}
    if a.check:
        d = Path(a.check).resolve()
        if not a.schematic:
            sys.exit("--check needs --schematic (your netlist of the NAND gate)")
        r = layout.check(d, "nand2", Path(a.schematic).resolve())
        out = d
    else:
        out = Path(a.out).resolve()
        spec = importlib.util.spec_from_file_location("ref_nand2", need_ref("wqlab nand2 without --check") / "step2_nand2" / "build_nand2.py")
        mod = importlib.util.module_from_spec(spec); spec.loader.exec_module(mod)
        r = mod.build(a.wn, a.wp, out, Path(a.schematic).resolve() if a.schematic else None)
    sc = stdcell()
    r["stdcell"] = sc
    if sc.get("area_um2"):
        r["area_ratio_vs_stdcell"] = round(r["area_um2"] / sc["area_um2"], 1)
    (out / "result.json").write_text(json.dumps(r, indent=1, ensure_ascii=False))
    print(json.dumps(r, ensure_ascii=False))
    return r


def test(a):
    tdir = Path(a.rtl).resolve() / "test"
    if a.ref:                       # teachers: the reference tests against the student's design
        tdir = Path(a.rtl).resolve() / "test_ref"
        if tdir.exists():
            shutil.rmtree(tdir)
        shutil.copytree(need_ref("wqlab test --ref") / "step3_rtl" / "test", tdir)
    t0 = time.time()
    p = subprocess.run(["make", "-C", str(tdir)], capture_output=True, text=True, timeout=1800)
    log = p.stdout + p.stderr
    (tdir / "wqlab_test.log").write_text(log)
    m = re.search(r"TESTS=(\d+) PASS=(\d+) FAIL=(\d+)", log)
    res = {"tests": int(m.group(1)) if m else 0, "passed": int(m.group(2)) if m else 0, "failed": int(m.group(3)) if m else -1,
           "seconds": round(time.time() - t0, 1)}
    res["all_passed"] = bool(m) and res["failed"] == 0 and res["tests"] > 0
    (Path(a.rtl).resolve() / "result.json").write_text(json.dumps(res, indent=1))
    print("\n".join(ln for ln in log.splitlines() if "PASS" in ln or "FAIL" in ln or "Error" in ln or "error" in ln)[-4000:])
    print(json.dumps(res))
    return res


TT_PORTS = {"ui_in": 8, "uo_out": 8, "uio_in": 8, "uio_out": 8, "uio_oe": 8, "ena": 1, "clk": 1, "rst_n": 1}
TT_TILE_UM = (161.0, 111.52)          # one Tiny Tapeout tile on SKY130 (to be confirmed against the official template before submitting)


def tt(a):
    """Tiny Tapeout format: top module tt_um_*, the fixed ports, fits in one tile; then RTL→GDS and readiness."""
    rtl = Path(a.rtl).resolve()
    out = Path(a.out or rtl.parent / "chip").resolve()
    design = out / "design_src"
    if design.exists():
        shutil.rmtree(design)
    design.mkdir(parents=True)
    shutil.copytree(rtl / "src", design / "src")
    cfg = json.loads((Path(a.config).resolve() if a.config else CAP / "start" / "step4_chip" / "config.json").read_text())
    (design / "config.json").write_text(json.dumps(cfg, indent=2))
    # format checks from the Verilog (via Yosys: the top module and its ports)
    yj = out / "ports.json"
    srcs = sorted(str(f) for f in (design / "src").glob("*.v"))
    sh(["yosys", "-q", "-p", f"read_verilog {' '.join(srcs)}; hierarchy -top {cfg['DESIGN_NAME']}; proc; write_json {yj}"], timeout=300)
    ports = {}
    if yj.exists():
        mod = json.loads(yj.read_text())["modules"].get(cfg["DESIGN_NAME"], {})
        ports = {k: len(v["bits"]) for k, v in mod.get("ports", {}).items()}
    fmt = {"top_name_ok": cfg["DESIGN_NAME"].startswith("tt_um_"), "ports_ok": ports == TT_PORTS,
           "die_um": cfg.get("DIE_AREA", [0, 0, 0, 0])[2:], "fits_one_tile": all(float(x) <= t + 1e-6 for x, t in zip(cfg.get("DIE_AREA", [0, 0, 1e9, 1e9])[2:], TT_TILE_UM))}
    fa = argparse.Namespace(config=str(design / "config.json"), out=str(out))
    res = flow(fa)
    res.update(fmt)
    res["ports"] = ports
    res["tt_ready"] = bool(res["tapeout_ready"] and fmt["top_name_ok"] and fmt["ports_ok"] and fmt["fits_one_tile"]
                           and res.get("antenna_violations") is not None and float(res["antenna_violations"]) == 0)
    (out / "result.json").write_text(json.dumps(res, indent=1, ensure_ascii=False))
    print(json.dumps(res, ensure_ascii=False))
    return res


def results(a):
    vals = {}
    for d in a.dirs:
        f = Path(d) / "result.json"
        if f.exists():
            for k, v in json.loads(f.read_text()).items():
                if isinstance(v, (int, float, bool)):
                    vals[f"{Path(d).name}_{k}"] = v
    out = {"results": vals, "env": env(), "at": time.strftime("%Y-%m-%dT%H:%M:%SZ", time.gmtime())}
    print(json.dumps(out, indent=1, ensure_ascii=False))
    return out


def main():
    ap = argparse.ArgumentParser(prog="wqlab", description=__doc__, formatter_class=argparse.RawDescriptionHelpFormatter)
    sub = ap.add_subparsers(dest="cmd", required=True)
    sub.add_parser("tools").set_defaults(fn=tools)
    p = sub.add_parser("netlist"); p.add_argument("sch"); p.add_argument("-o", "--out"); p.set_defaults(fn=netlist)
    p = sub.add_parser("inv"); p.add_argument("--wn", type=float, default=0.42); p.add_argument("--wp", type=float, default=0.97)
    p.add_argument("--schematic"); p.add_argument("--out", default="inv_build"); p.set_defaults(fn=inv)
    p = sub.add_parser("flow"); p.add_argument("config"); p.add_argument("--out"); p.set_defaults(fn=flow)
    p = sub.add_parser("results"); p.add_argument("dirs", nargs="+"); p.set_defaults(fn=results)
    p = sub.add_parser("start"); p.add_argument("dir"); p.set_defaults(fn=start)
    p = sub.add_parser("device"); p.add_argument("--out", default="step1_out"); p.add_argument("--script", help="your device_curves.py")
    p.set_defaults(fn=device)
    p = sub.add_parser("nand2"); p.add_argument("--wn", type=float, default=0.42); p.add_argument("--wp", type=float, default=0.97)
    p.add_argument("--schematic"); p.add_argument("--start", metavar="DIR", help="make the starting layout (transistors placed) in DIR")
    p.add_argument("--check", metavar="DIR", help="check your layout DIR/nand2.mag"); p.add_argument("--out", default="nand2_build")
    p.set_defaults(fn=nand2)
    p = sub.add_parser("test"); p.add_argument("rtl"); p.add_argument("--ref", action="store_true", help="run the reference tests (teachers)")
    p.set_defaults(fn=test)
    p = sub.add_parser("tt"); p.add_argument("rtl"); p.add_argument("--config"); p.add_argument("--out"); p.set_defaults(fn=tt)
    a = ap.parse_args()
    r = a.fn(a)
    if a.cmd == "inv":
        sys.exit(0 if r["drc_errors"] == 0 and r["lvs_match"] else 1)
    if a.cmd == "flow":
        sys.exit(0 if r["tapeout_ready"] else 1)
    if a.cmd in ("nand2",) and "started" not in r:
        sys.exit(0 if r["drc_errors"] == 0 and r["lvs_match"] else 1)
    if a.cmd == "test":
        sys.exit(0 if r["all_passed"] else 1)
    if a.cmd == "tt":
        sys.exit(0 if r["tt_ready"] else 1)


if __name__ == "__main__":
    main()
