# 国内服务器：凸轮、轴承、问渠电子在本机容器里（第 173 轮从 Caddyfile 挪来，内容不变）。
# 问渠凸轮（第 39 轮）：凸轮设计网页版，容器 cam 自己出页面和接口
redir /cam /cam/ 308
handle_path /cam/* {
	reverse_proxy cam:8000
}
# 问渠轴承（第 64 轮）：轴承设计网页版，容器 bearing 自己出页面和接口
redir /bearing /bearing/ 308
handle_path /bearing/* {
	reverse_proxy bearing:8000
}
# 问渠电子（第 105 轮）：起草台，容器 eda 自己出页面和接口；AI 起草经网关
redir /eda /eda/ 308
handle_path /eda/* {
	reverse_proxy eda:8000
}
