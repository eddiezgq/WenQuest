# Serves the WenQuest web app. Used inside the web container, behind the main Caddy in production.
{
	admin off
	auto_https off
	servers {
		# Keep the visitor's address from the front Caddy (used for sign-up code limits).
		trusted_proxies static private_ranges
	}
}

:80 {
	encode zstd gzip

	handle /api/* {
		reverse_proxy {$GATEWAY_UPSTREAM:gateway:8000}
	}

	handle {
		root * /srv/app
		# Hashed build assets never change; the HTML shell must always be fresh.
		@assets path /assets/*
		header @assets Cache-Control "public, max-age=31536000, immutable"
		header /index.html Cache-Control "no-cache"
		# History-mode routes (e.g. /pages/course/course) fall back to the app shell.
		try_files {path} /index.html
		file_server
	}
}
